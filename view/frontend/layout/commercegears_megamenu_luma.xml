<?xml version="1.0"?>
<!--
    Luma (and other RequireJS themes): added by Observer\AddLayoutHandle when the menu is enabled for the store view.
    Removes Magento's top menu block and puts the mega menu into the same place (the "Menu" section of the navigation).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="CommerceGears_MegaMenu::css/mega-menu.css"/>
    </head>
    <body>
        <referenceBlock name="catalog.topnav" remove="true"/>
        <referenceBlock name="store.menu">
            <block class="CommerceGears\MegaMenu\Block\Menu" name="commercegears.megamenu" template="CommerceGears_MegaMenu::menu.phtml" before="-">
                <arguments>
                    <argument name="commercegears_mm_theme" xsi:type="string">luma</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
